# Database
DATABASE_URL=postgresql://traceforge:traceforge@localhost:5432/traceforge

# API
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# Auth (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-in-production
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/uploads
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# GitHub (Phase 2)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Notion / Linear (Phase 4)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# MCP
MCP_SERVER_PORT=4100
MCP_API_TOKEN=

# Database seed (local dev: demo user enabled when NODE_ENV != production)
SEED_DEMO_DATA=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# API: allow public registration (default on in dev; in production set true to enable sign-up UI)
ALLOW_REGISTRATION=

# Web UI (set true only in local dev to show demo login hint)
NEXT_PUBLIC_SHOW_DEMO_LOGIN=

# Optional: Redis for realtime fanout
REDIS_URL=
