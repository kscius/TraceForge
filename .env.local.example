# Copy to .env.local (gitignored) for isolated local development:
#   cp .env.local.example .env.local
#
# Ports are chosen to avoid clashes with other stacks on the same machine.

# Host-only tools (Prisma Studio, optional pnpm dev). Docker stack uses db:5432 inside Compose.
# DATABASE_URL=postgresql://traceforge:traceforge@localhost:15432/traceforge

# API
API_HOST=0.0.0.0
API_PORT=14000
API_PUBLIC_URL=http://localhost:14000
WEB_PUBLIC_URL=http://localhost:13000

# Web (baked at Docker build time for the local stack)
NEXT_PUBLIC_API_URL=http://localhost:14000

# Auth — generate for non-demo use: openssl rand -base64 32
SESSION_SECRET=dev-session-secret-change-me
JWT_ACCESS_SECRET=dev-jwt-access-change-me
JWT_REFRESH_SECRET=dev-jwt-refresh-change-me

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/uploads

MCP_SERVER_PORT=14100
TRACEFORGE_API_URL=http://localhost:14000
