{
  "name": "traceforge",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted development traceability platform — tasks, Git, MCP, and AI context",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "pnpm --filter @traceforge/db exec prisma generate",
    "db:migrate": "pnpm --filter @traceforge/db exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @traceforge/db exec prisma migrate deploy",
    "db:seed": "pnpm --filter @traceforge/db exec tsx prisma/seed.ts",
    "db:studio": "pnpm --filter @traceforge/db exec prisma studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
