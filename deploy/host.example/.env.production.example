# Copy to deploy/host/.env.production (gitignored) and fill in values.
# Public URLs must match your reverse proxy / TLS host.

TRACEFORGE_PUBLIC_HOST=traceforge.example.com

POSTGRES_PASSWORD=

API_PUBLIC_URL=https://${TRACEFORGE_PUBLIC_HOST}
WEB_PUBLIC_URL=https://${TRACEFORGE_PUBLIC_HOST}
NEXT_PUBLIC_API_URL=https://${TRACEFORGE_PUBLIC_HOST}

SESSION_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

GITHUB_WEBHOOK_SECRET=

# Optional object storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/uploads
