# Example reverse proxy — copy to deploy/host/Caddyfile and set TRACEFORGE_PUBLIC_HOST.
# Requires Caddy on the host (or caddy docker) with DNS pointing at this machine.

{$TRACEFORGE_PUBLIC_HOST} {
	encode gzip

	handle /api/* {
		reverse_proxy localhost:14080
	}

	handle /docs* {
		reverse_proxy localhost:14080
	}

	handle {
		reverse_proxy localhost:13080
	}
}
