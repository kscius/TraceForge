    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@traceforge/db": "workspace:*",
    "@traceforge/domain": "workspace:*",
    "@traceforge/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.2.1",
    "jose": "^6.0.10",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
